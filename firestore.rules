rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function orderTrustedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status',
        'selectedMasterId',
        'selectedMasterName',
        'selectedPrice',
        'selectedAt',
        'startedAt',
        'readyAt',
        'deliveredAt',
        'responses',
        'responseCount'
      ]);
    }

    function isChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return request.auth != null
        && (chat.customerId == request.auth.uid || chat.masterId == request.auth.uid);
    }

    function validReadCounterUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['unreadCustomer', 'unreadMaster'])
        && ((resource.data.customerId == request.auth.uid
             && request.resource.data.unreadCustomer == 0
             && request.resource.data.unreadMaster == resource.data.unreadMaster)
            || (resource.data.masterId == request.auth.uid
                && request.resource.data.unreadMaster == 0
                && request.resource.data.unreadCustomer == resource.data.unreadCustomer));
    }

    // Private account, contact and verification data is owner-readable only.
    // All mutations go through authenticated server commands.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /commandReceipts/{commandId} {
        allow read, write: if false;
      }
    }

    // Sanitized projection: aliases and marketplace statistics, never contact
    // details or verification evidence.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Order reads and creates are server-mediated so eligibility and field
    // projection cannot be bypassed. Remaining owner edits are narrowed until
    // delete/review commands complete the migration.
    match /orders/{orderId} {
      allow read:   if false;
      allow create: if false;
      allow update: if request.auth != null
                    && resource.data.customerId == request.auth.uid
                    && orderTrustedFieldsUnchanged();
      allow delete: if request.auth != null
                    && resource.data.customerId == request.auth.uid;

      match /proposals/{masterId} {
        allow read: if request.auth != null
                    && (request.auth.uid == masterId
                        || get(/databases/$(database)/documents/orders/$(orderId)).data.customerId
                           == request.auth.uid);
        allow write: if false;

        match /versions/{versionId} {
          allow read: if request.auth != null
                      && (request.auth.uid == masterId
                          || get(/databases/$(database)/documents/orders/$(orderId)).data.customerId
                             == request.auth.uid);
          allow write: if false;
        }
      }

      match /commandReceipts/{commandId} {
        allow read, write: if false;
      }
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    match /commandReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /outboxEvents/{eventId} {
      allow read, write: if false;
    }

    // Chat content is private. Message creation and preview counters are
    // server-only; a participant may only clear their own unread counter.
    match /chats/{chatId} {
      allow read: if isChatParticipant(chatId);
      allow create, delete: if false;
      allow update: if isChatParticipant(chatId) && validReadCounterUpdate();

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if false;
        allow update: if isChatParticipant(chatId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                      && request.resource.data.read == true
                      && resource.data.senderId != request.auth.uid;
        allow delete: if false;
      }
    }

    // System notifications are server-created. The recipient controls only
    // their own read state or deletion.
    match /notifications/{notifId} {
      allow read:          if request.auth != null
                           && resource.data.userId == request.auth.uid;
      allow create:        if false;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }
  }
}
