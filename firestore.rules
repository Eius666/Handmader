rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private account, contact and verification data is owner-readable only.
    // All mutations go through authenticated server commands.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /commandReceipts/{commandId} {
        allow read, write: if false;
      }
    }

    // Sanitized projection: aliases and marketplace statistics, never contact
    // details or verification evidence.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Order reads and every mutation are server-mediated so eligibility,
    // audit history and field projection cannot be bypassed.
    match /orders/{orderId} {
      allow read:   if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /proposals/{masterId} {
        allow read: if request.auth != null
                    && (request.auth.uid == masterId
                        || get(/databases/$(database)/documents/orders/$(orderId)).data.customerId
                           == request.auth.uid);
        allow write: if false;

        match /versions/{versionId} {
          allow read: if request.auth != null
                      && (request.auth.uid == masterId
                          || get(/databases/$(database)/documents/orders/$(orderId)).data.customerId
                             == request.auth.uid);
          allow write: if false;
        }
      }

      match /commandReceipts/{commandId} {
        allow read, write: if false;
      }
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    match /commandReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /outboxEvents/{eventId} {
      allow read, write: if false;
    }

    // Staff identities are provisioned out of band and are never readable or
    // writable by the marketplace client.
    match /staffMembers/{staffId} {
      allow read, write: if false;
    }

    // Customer requests and staff decisions contain support-only reasons and
    // are projected exclusively through authenticated server APIs.
    match /reselectionCases/{caseId} {
      allow read, write: if false;

      match /commandReceipts/{commandId} {
        allow read, write: if false;
      }
    }

    // Reviews are submitted and published by trusted server commands. Pending
    // feedback must not be observable by the other order participant.
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // Final terms and the test payment ledger are server-owned. Participants
    // receive projected data through authenticated APIs.
    match /agreements/{agreementId} {
      allow read, write: if false;

      match /versions/{versionId} {
        allow read, write: if false;
      }
    }

    match /payments/{paymentId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // Material advances and expense evidence are financial records. They are
    // visible to participants only through authenticated server projections.
    match /materialAdvances/{advanceId} {
      allow read, write: if false;
    }

    // Chat content, history and read state are projected through authenticated
    // server APIs. The browser cannot query or mutate the raw documents.
    match /chats/{chatId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // Notifications, including read state, are projected and mutated through
    // authenticated server APIs. The browser cannot forge or rewrite events.
    match /notifications/{notifId} {
      allow read, write: if false;
    }
  }
}
