rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function orderTrustedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status',
        'selectedMasterId',
        'selectedMasterName',
        'selectedPrice',
        'selectedAt',
        'startedAt',
        'readyAt',
        'deliveredAt',
        'responses',
        'responseCount',
        'ratings',
        'reviewAuthorIds',
        'flowVersion',
        'agreementStatus',
        'agreementVersion',
        'finalPrice',
        'paymentStatus',
        'paymentId',
        'paidAt'
      ]);
    }

    // Private account, contact and verification data is owner-readable only.
    // All mutations go through authenticated server commands.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /commandReceipts/{commandId} {
        allow read, write: if false;
      }
    }

    // Sanitized projection: aliases and marketplace statistics, never contact
    // details or verification evidence.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Order reads and creates are server-mediated so eligibility and field
    // projection cannot be bypassed. Remaining owner edits are narrowed until
    // delete/review commands complete the migration.
    match /orders/{orderId} {
      allow read:   if false;
      allow create: if false;
      allow update: if request.auth != null
                    && resource.data.customerId == request.auth.uid
                    && orderTrustedFieldsUnchanged();
      allow delete: if request.auth != null
                    && resource.data.customerId == request.auth.uid;

      match /proposals/{masterId} {
        allow read: if request.auth != null
                    && (request.auth.uid == masterId
                        || get(/databases/$(database)/documents/orders/$(orderId)).data.customerId
                           == request.auth.uid);
        allow write: if false;

        match /versions/{versionId} {
          allow read: if request.auth != null
                      && (request.auth.uid == masterId
                          || get(/databases/$(database)/documents/orders/$(orderId)).data.customerId
                             == request.auth.uid);
          allow write: if false;
        }
      }

      match /commandReceipts/{commandId} {
        allow read, write: if false;
      }
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    match /commandReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /outboxEvents/{eventId} {
      allow read, write: if false;
    }

    // Reviews are submitted and published by trusted server commands. Pending
    // feedback must not be observable by the other order participant.
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // Final terms and the test payment ledger are server-owned. Participants
    // receive projected data through authenticated APIs.
    match /agreements/{agreementId} {
      allow read, write: if false;

      match /versions/{versionId} {
        allow read, write: if false;
      }
    }

    match /payments/{paymentId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // Chat content, history and read state are projected through authenticated
    // server APIs. The browser cannot query or mutate the raw documents.
    match /chats/{chatId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // Notifications, including read state, are projected and mutated through
    // authenticated server APIs. The browser cannot forge or rewrite events.
    match /notifications/{notifId} {
      allow read, write: if false;
    }
  }
}
